# ============================================================
# PiedPiper Inventario · configuración de entorno
# Copia este archivo como .env y ajusta los valores reales.
# ============================================================

# Clave de sesión: genera una nueva con
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
COOKIE_SECURE=false

# --- MariaDB -------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=piedpiper
DB_PASSWORD=cambia-esta-password
DB_NAME=piedpiper_erp

# --- Producto ------------------------------------------------
# DEMO_MODE muestra las credenciales de demostración en el login.
# Desactívalo en producción: DEMO_MODE=false
DEMO_MODE=true
SOPORTE_EMAIL=soporte@piedpiper.software
